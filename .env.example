# ElevenLabs (Text-to-Speech)
# Setup: https://elevenlabs.io/docs/api-reference/authentication
# Get API key: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Cloudflare R2 Storage
# Setup: https://developers.cloudflare.com/r2/api/tokens/
# Dashboard: https://dash.cloudflare.com/ → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=emots
R2_PUBLIC_URL=

# Discord (Error Reporting)
# Setup: https://support.discord.com/hc/en-us/articles/228383668-Intro-to-Webhooks
# Server Settings → Integrations → Create Webhook
DISCORD_ERROR_WEBHOOK_URL=

# Raindrop.io (Bookmarks)
# Setup: https://app.raindrop.io/settings/integrations
# Create app → copy "Test token" (non-expiring, personal use)
RAINDROP_ACCESS_TOKEN=

# Discord (Bookmark Submissions)
# Separate webhook for bookmark submissions with approve/reject buttons
DISCORD_BOOKMARKS_WEBHOOK_URL=

# Bookmarks Approval Secret
# Random string (min 16 chars) for HMAC-signing approve/reject URLs
# Generate: openssl rand -hex 32
BOOKMARKS_APPROVAL_SECRET=

# Client-side
VITE_BASE_URL=http://localhost:3000
VITE_R2_URL=https://cdn.emots.dev
